    "p_bh": { "type": ["number", "null"] },
    "m": { "type": "integer", "minimum": 1 },
    "n_total": { "type": ["integer", "null"] },
    "n_match": { "type": ["integer", "null"] },
    "n_judgeable": { "type": ["integer", "null"] },
    "n_empty_realized": { "type": ["integer", "null"] },
    "n_dur_le_0": { "type": ["integer", "null"] },
    "n_total_status": { "type": "string" },
    "n_match_status": { "type": "string" },
    "n_judgeable_status": { "type": "string" },
    "n_empty_realized_status": { "type": "string" },
    "n_dur_le_0_status": { "type": "string" },
    "singing_prob_source": {
      "type": "string",
      "const": "task2_window_quality/window_quality_with_flags.csv"
    },
    "G_h": { "type": ["integer", "null"] },
    "n_h_judgeable": { "type": ["integer", "null"] },
    "ci_unreliable": { "type": "integer", "enum": [0, 1] },
    "conclusion": { "type": "string" },
