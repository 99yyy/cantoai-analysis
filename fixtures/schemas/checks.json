{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fixtures/schemas/checks.json",
  "title": "Contract checks.json",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "status", "expected", "expected_source", "observed", "missing"],
    "properties": {
      "name": { "type": "string", "minLength": 1 },
      "status": { "enum": ["PASS", "FAIL", "SKIP"] },
      "expected": {},
      "expected_source": {
        "type": "string",
        "pattern": "^(frame\\.yaml|rounds/ROUND-[0-9]+\\.yaml|expected/.+):.+"
      },
      "observed": {},
      "missing": { "type": ["string", "null"] }
    }
  }
}
