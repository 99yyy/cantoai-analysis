{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fixtures/manifest.schema.json",
  "title": "ROUND-3 run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "inputs",
    "strata",
    "master_seed",
    "stratum_seeds",
    "B",
    "git_sha",
    "git_dirty",
    "frame_yaml_blob_sha",
    "row_accounting"
  ],
  "properties": {
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "row_count", "columns"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "row_count": { "type": "integer", "minimum": 0 },
          "columns": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "strata": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["h", "N_h", "n_h_sampled", "n_h_judgeable", "w_h", "G_h"],
        "properties": {
          "h": { "type": "string" },
          "N_h": { "type": "integer", "minimum": 0 },
          "n_h_sampled": { "type": "integer", "minimum": 0 },
          "n_h_judgeable": { "type": "integer", "minimum": 0 },
          "w_h": { "type": ["number", "null"] },
          "G_h": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "master_seed": { "type": "integer" },
    "stratum_seeds": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "B": { "type": "integer", "minimum": 1000 },
    "git_sha": { "type": "string" },
    "git_dirty": { "type": "boolean" },
    "frame_yaml_blob_sha": { "type": "string" },
    "row_accounting": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "rule", "group", "rows_before", "rows_after"],
        "properties": {
          "step": { "type": "string" },
          "rule": { "type": "string" },
          "group": { "type": "string" },
          "rows_before": { "type": "integer", "minimum": 0 },
          "rows_after": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "unassigned": { "type": "integer", "minimum": 0 }
  }
}
