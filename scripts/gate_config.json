{
  "_about": [
    "Project-specific facts the gate scripts read. The scripts themselves name no",
    "table, column, tier, side file or number prefix; everything of that kind is",
    "here. CI copies this file next to the base-branch gate copies (/tmp/gate),",
    "so a pull request cannot change the gate it is judged by. Any change to",
    "this file is a bar move (history-audit)."
  ],
  "corpus": "data/corpus_v2.sqlite",
  "pin_file": "README.md",
  "gate_tests": {
    "_about": [
      "Tests of the gate scripts, by exact path. CI runs them first, before any",
      "code a worker wrote, from a copy of the tree whose tests/ holds only these",
      "files, their fixtures and mutation probes, and which has no src/: worker",
      "branches may write tests/** and src/**, and a module (or a native",
      "extension) there could otherwise change what these tests check. None of",
      "them may import src/. A pull request is judged by the union of this list",
      "on the base branch and on its own head, so a change cannot drop a test.",
      "The files are gate files (history-audit)."
    ],
    "files": [
      "tests/test_budget.py",
      "tests/test_fork.py",
      "tests/test_history_audit.py",
      "tests/test_identities.py",
      "tests/test_message_inventory.py",
      "tests/test_output_check.py",
      "tests/test_output_check_scoring.py",
      "tests/test_relations.py",
      "tests/test_result_json.py",
      "tests/test_scope_check.py",
      "tests/test_verify.py"
    ]
  },
  "sides": {
    "worker": "results.json",
    "verifier": "mine.json"
  },
  "tables": {
    "videos": {
      "key": "video_id"
    },
    "windows": {
      "key": "uid",
      "refs": {
        "video_id": "videos"
      }
    },
    "syllables": {
      "key": "syl_id",
      "refs": {
        "uid": "windows",
        "video_id": "videos"
      },
      "type_columns": [
        "char"
      ]
    }
  },
  "other_tables": [
    "runs"
  ],
  "unit_table": "syllables",
  "families": {
    "count": {
      "prefix": [
        "n_"
      ]
    },
    "rate": {
      "prefix": [
        "agree_",
        "rare_share_",
        "gap_",
        "did_"
      ],
      "prefix_suffix": [
        [
          "rate_",
          "_pm"
        ]
      ]
    }
  },
  "scope": {
    "_about": [
      "Branch classes for scope_check.py. Match order is the list order of",
      "'classes': the first regex that matches names the class. An agent branch",
      "carries a task id and a role; the role's write set is the only thing it",
      "may touch ({task} is the task id from the branch name). A non-role class's",
      "allow may also use {task}, taken from the named group in its match.",
      "Owner-only classes need the pull-request author on the owner allowlist."
    ],
    "protected": [
      ".cursor/*",
      ".cursor/**",
      ".github/*",
      ".github/**",
      "data/*",
      "data/**",
      "benchmarks/*",
      "benchmarks/**",
      "scripts/*",
      "scripts/**",
      "README.md",
      "LOOP.md"
    ],
    "brief": "^tasks/[^/]+\\.md$",
    "classes": [
      {
        "name": "agent",
        "match": "^(?:cursor|box)/[rt](?P<task>\\d+(?:-[a-z])?)-(?P<role>[a-z0-9_]+)-",
        "owner_only": false,
        "no_brief": true,
        "roles": {
          "worker": [
            "tasks/TASK-{task}/results.json",
            "tasks/TASK-{task}/sql/*",
            "tasks/TASK-{task}/sql/**",
            "tasks/TASK-{task}/pred/*",
            "tasks/TASK-{task}/pred/**",
            "tasks/TASK-{task}/open_analysis.md",
            "tasks/TASK-{task}/manifest.json",
            "tasks/TASK-{task}/bootstrap.json",
            "tasks/TASK-{task}/decomposition.json",
            "tasks/TASK-{task}/run_worker.py",
            "tasks/TASK-{task}/STATUS.json",
            "src/*",
            "src/**",
            "tests/*",
            "tests/**"
          ],
          "verifier": [
            "tasks/TASK-{task}/mine.json",
            "tasks/TASK-{task}/mine_sql/*",
            "tasks/TASK-{task}/mine_sql/**",
            "tasks/TASK-{task}/mine_pred/*",
            "tasks/TASK-{task}/mine_pred/**"
          ],
          "auditor": [
            "review/TASK-{task}/*",
            "review/TASK-{task}/**",
            "tasks/TASK-{task}/RESULT.json",
            "tasks/TASK-{task}/launches.json",
            "backlog.md"
          ]
        }
      },
      {
        "name": "close",
        "match": "^repair/task-(?P<task>\\d+(?:-[a-z])?)-close-",
        "owner_only": true,
        "no_brief": false,
        "allow": [
          "tasks/TASK-{task}.md",
          "tasks/TASK-{task}/RESULT.json",
          "tasks/TASK-{task}/launches.json",
          "review/TASK-{task}/*",
          "review/TASK-{task}/**",
          "backlog.md"
        ],
        "deny": "protected"
      },
      {
        "name": "repair",
        "match": "^(?:repair/|cursor/repair-)",
        "owner_only": true,
        "no_brief": false,
        "allow": null,
        "deny": []
      },
      {
        "name": "chore",
        "match": "^chore/",
        "owner_only": true,
        "no_brief": false,
        "allow": [
          "BACKGROUND.md",
          "PIPELINE.md",
          "REPORT.md",
          "RESEARCH_LOG.md",
          "backlog.md",
          "STOP",
          "tasks/*",
          "tasks/**",
          "docs/*",
          "docs/**",
          "investigations/*",
          "investigations/**"
        ],
        "deny": "protected"
      }
    ]
  }
}
